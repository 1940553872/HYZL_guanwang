  },
  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1440 },
  "grid": {
    "xs": { "columns": 4, "gutter": 16, "margin": 16 },
    "md": { "columns": 8, "gutter": 20, "margin": 32 },
    "lg": { "columns": 12, "gutter": 24, "margin": 40 },
    "xl": { "columns": 12, "gutter": 24, "margin": 48, "container": 1280 }

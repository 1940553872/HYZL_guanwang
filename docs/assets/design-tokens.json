    "danger": { "$value": "#C8281E", "$type": "color" },
    "info": { "$value": "#1F5FD1", "$type": "color" },
    "data": {
      "light": ["#1F5FD1", "#F2611D", "#177A3F", "#A15C00", "#6B7178"],
      "dark": ["#4C8DFF", "#FF7A3D", "#3FBF7F", "#FFB38A", "#A3A9B0"]
    }
  },
  "font": {
    "family": {
      "sans": "\"HarmonyOS Sans SC\", \"Source Han Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "latin": "Inter, \"HarmonyOS Sans SC\", sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, monospace"
    },
    "scale": {
      "display": { "desktop": [64, 76], "mobile": [36, 44], "weight": 700, "tracking": "-0.02em" },

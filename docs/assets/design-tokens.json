      "h4": { "desktop": [22, 32], "mobile": [18, 28], "weight": 600 },
      "stat": { "desktop": [56, 64], "mobile": [40, 48], "weight": 700, "tracking": "-0.02em" },
      "bodyLg": { "desktop": [18, 32], "mobile": [16, 28], "weight": 400 },
      "body": { "desktop": [16, 28], "mobile": [16, 28], "weight": 400 },
      "bodySm": { "desktop": [14, 22], "mobile": [14, 22], "weight": 400 },
      "caption": { "desktop": [12, 18], "mobile": [12, 18], "weight": 400, "tracking": "0.02em" },
      "mono": { "desktop": [14, 22], "mobile": [13, 20], "weight": 400 }
